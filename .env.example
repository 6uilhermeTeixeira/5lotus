# 2Lotus — copie este arquivo para .env e preencha os valores locais.
# Nunca versione .env nem envie valores de chaves, senhas ou tokens pelo chat.

# Supabase: Settings > API
DAYTRADE_SUPABASE_PROJECT_REF=yluszrsumrqzmdueiyyc
DAYTRADE_SUPABASE_URL=https://yluszrsumrqzmdueiyyc.supabase.co
DAYTRADE_SUPABASE_SERVICE_ROLE_KEY=PREENCHA_COM_A_SERVICE_ROLE_KEY_DO_2LOTUS
DAYTRADE_SUPABASE_PUBLISHABLE_KEY=PREENCHA_COM_A_PUBLISHABLE_KEY_DO_2LOTUS
# Supabase CLI: token pessoal da conta, usado somente no servidor para migrations.
SUPABASE_ACCESS_TOKEN=PREENCHA_COM_UM_ACCESS_TOKEN_PESSOAL_DO_SUPABASE

# Autenticação da página de resultados e da ingestão MT5 -> API.
DAYTRADE_DASHBOARD_PASSWORD=PREENCHA_COM_UMA_SENHA_FORTE
DAYTRADE_SESSION_SECRET=PREENCHA_COM_UM_SEGREDO_ALEATORIO_DE_NO_MINIMO_32_CARACTERES
DAYTRADE_INGEST_API_KEY=PREENCHA_COM_UMA_CHAVE_ALEATORIA_PARA_O_MT5

# Serviço Python
DAYTRADE_HOST=0.0.0.0
DAYTRADE_PORT=8000
DAYTRADE_ENABLE_LIVE_DECISIONS=false
DAYTRADE_RESULTS_STORE=SUPABASE
DAYTRADE_FIMATH_MODE=shadow
DAYTRADE_CHART_CACHE_LIMIT=5000
DAYTRADE_FIMATH_FLOW_POLICY=veto
DAYTRADE_FIMATH_FLOW_WINDOW_SECONDS=300
DAYTRADE_FIMATH_FLOW_MIN_SAMPLES=30
DAYTRADE_FIMATH_FLOW_Z_THRESHOLD=1.0
DAYTRADE_FIMATH_MIN_CLOSED_PAPER_TRADES=30

# MT5: preencher somente no servidor que executa o terminal.
DAYTRADE_MT5_LOGIN=PREENCHA_COM_O_LOGIN_DA_CONTA_DEMO
DAYTRADE_MT5_PASSWORD=PREENCHA_COM_A_SENHA_DA_CONTA_DEMO
DAYTRADE_MT5_SERVER=PREENCHA_COM_O_SERVIDOR_DA_CORRETORA
